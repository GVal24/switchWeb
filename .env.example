# SWITCH - plantilla de variables de entorno
#
# Local: copiá este archivo como .env en la raíz y completá la configuración
# de tu PostgreSQL local.
# Render: cargá los mismos nombres de variables en Environment del servicio.
# El backend detecta Render y no carga ni sobrescribe el .env local.

# Puerto del servidor. Render define PORT automáticamente.
PORT=3000

# PostgreSQL local. En Render, usá las credenciales de Neon con estos nombres.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=switch_db
DB_SSL=false

# Alternativa en Render: usar la connection string de Neon en lugar de DB_*.
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST.neon.tech/BASE?sslmode=require

# Claves locales de ejemplo. En Render, generá y configurá claves secretas propias.
JWT_SECRET=cambiar-por-una-clave-larga-y-secreta
OTP_HMAC_SECRET=clave-local-para-codigos-otp

# MOCK es únicamente para desarrollo local.
OTP_PROVEEDOR=MOCK
# En Render, por ejemplo: OTP_PROVEEDOR=TWILIO_SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# DEMO CONTROLADA: permite el OTP mock también en producción. El código
# aparece en la pantalla de registro, así que cualquiera podría verificar
# cualquier teléfono. Usarlo sólo para una demo y apagarlo después.
# OTP_PERMITIR_MOCK_PRODUCCION=true
# Allowlist opcional: sólo estos teléfonos pueden usar el mock en producción.
# Acepta el número completo o los últimos 10 dígitos, separados por comas.
# OTP_MOCK_TELEFONOS=1123456789,1198765432

# Validación de distancia por GPS en el escaneo de QR.
GPS_VALIDACION_ACTIVA=false

# Orígenes CORS permitidos, separados por comas. Vacío permite cualquier origen.
ORIGENES_PERMITIDOS=
