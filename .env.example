# ============================================================
# SWITCH - variables de entorno
# ============================================================
# Copiá este archivo como .env y completá los valores.
#
# En Render (u otro hosting del backend) estas variables se cargan en la
# sección "Environment Variables" del panel del servicio, NO en un archivo.
# ============================================================

# Puerto del servidor. En Render se define solo; en local, 3000.
PORT=3000

# ------------------------------------------------------------
# Base de datos PostgreSQL
# En Neon, copiá los datos de la cadena de conexión:
#   postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
# ------------------------------------------------------------
DB_USER=usuario
DB_PASSWORD=clave
DB_HOST=host.neon.tech
DB_PORT=5432
DB_NAME=neondb

# SSL: las bases administradas (Neon, Supabase, Render) exigen conexión
# cifrada. Poné true, o dejaló vacío y se activa solo si el host es de esas nubes.
DB_SSL=true

# Clave para firmar los tokens de sesión (JWT). Usá un texto largo y único.
JWT_SECRET=cambiar-por-una-clave-larga-y-secreta

# Validación de distancia por GPS en el escaneo de QR (true = activa, radio 200m)
GPS_VALIDACION_ACTIVA=false

# ------------------------------------------------------------
# CORS: orígenes permitidos, separados por comas.
# Si se deja vacío, se acepta cualquier origen (desarrollo local).
# Al publicar, poné la URL de la web, por ejemplo:
#   ORIGENES_PERMITIDOS=https://switch.vercel.app
# Para el proyecto de Vercel de un usuario puntual sería algo como:
#   ORIGENES_PERMITIDOS=https://switch-tunombre.vercel.app,http://localhost:3000
# ------------------------------------------------------------
ORIGENES_PERMITIDOS=
