root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]

trim_trailing_whitespace = false

[*.{dart}]
indent_size = 2

[*.sql]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,pdf,ico,woff,woff2,ttf,eot,mp3,mp4}]
insert_final_newline = unset
trim_trailing_whitespace = unset
